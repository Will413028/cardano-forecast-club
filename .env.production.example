# Copy to .env.production (ignored). Values marked secret must never be committed.
PUBLIC_ORIGIN=https://forecast.example.com
SMTP_URL=smtps://resend:<secret API key>@smtp.resend.com:465
MAIL_FROM=Forecast Club <login@forecast.example.com>
ADMIN_EMAILS=operator@example.com
CHAIN_MODE=local
# secret: openssl rand -hex 24
POSTGRES_PASSWORD=
# secret: Cloudflare Zero Trust → Networks → Tunnels → install connector token
TUNNEL_TOKEN=
