{
  "name": "cardano-forecast-club",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "tsx apps/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "check": "python3 scripts/secret-scan.py && prettier --check apps packages scripts/*.ts tests vite.config.ts && tsc --noEmit && tsx --test tests/*.test.ts && vite build",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "tsx scripts/e2e-round.ts",
    "verify": "tsx apps/verifier/main.ts",
    "ops-check": "tsx scripts/ops-check.ts",
    "baseline": "tsx scripts/baseline.ts",
    "format": "prettier --write apps packages scripts/*.ts tests vite.config.ts"
  },
  "dependencies": {
    "@meshsdk/core": "1.9.1",
    "express": "^5.1.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
